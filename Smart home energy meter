using namespace std;

inline double wattToKilowatt(double wattage)
{
    return wattage/1000;
}
class Appliance
{
public:
    string name;
    double wattage,hoursPerDay;
    static int totalAppliances;
    Appliance()
    {
        wattage=0;
        hoursPerDay=0;
        totalAppliances++;
    }

    double calculateUnits()
    {
        return wattToKilowatt(wattage)*hoursPerDay*30;
    }
    void display()
    {
        cout<<name<<":"<<calculateUnits()<<"units"<<endl;
    }

};
int Appliance::totalAppliances=0;
class Meter
{
public:
    double calculateTotalUnits(Appliance appliances[],int size)
    {
        double total=0;

        for(int i=0;i<size;i++)
        {
            total+=appliances[i].calculateUnits();
        }

        return total;
    }

void displayAppliances(Appliance appliances[],int size)
{
    Appliance* ptr=appliances;
    for (int i=0;i<size;i++)
    {
        (*ptr).display();
        ptr++;

    }

}
double monthlyConsumption[12][3];
void storeMonthlyData(int month,Appliance appliances[],int size)
{
    for (int i=0;i<size;i++)
    {
        monthlyConsumption[month][i]=
        appliances[i].calculateUnits();
    }
}
void displayMonthlyData(int month,int size)
{
    cout<<"Monthly Consumption:\n";

    for(int i=0;i<size;i++)
    {
        cout<<monthlyConsumption[month][i]
        <<" units"<<endl;
    }
}
double  predictNextMonth(int months,int applianceIndex)
{
    double total=0;
    for(int i=0;i<months;i++)
    {
        total+=monthlyConsumption[i][applianceIndex];
    }
    return total/months;
}
void displayPrediction(int months,int size)
{
    cout<<"Next Month Consumption Ranking"<<endl;

    for(int i=0;i<size;i++)
    {
        double predicted=predictNextMonth(months,i);

        cout<<"Appliance "<<i+1
            <<": "<<predicted<<" units"<<endl;
    }
}
double predictTotalUnits(int months,int size)
{
    double total=0;
    for(int i=0;i<size;i++)
    {
        total+=predictNextMonth(months,i);
    }
    return total;
}
void saveAppliances(Appliance appliances[],int size)
{
    ofstream file("Appliances.txt");

    if(!file)
    {
        cout<<"File opening error"<<endl;
        return;
    }

    for(int i=0;i<size;i++)
    {
        file<<appliances[i].name<<" "
            <<appliances[i].wattage<<" "
            <<appliances[i].hoursPerDay<<endl;
    }
    file.close();
    cout<<"Appliances saved successfully"<<endl;
}
void rankAppliances(Appliance appliances[],int size)
{
    for (int i =0;i<size-1;i++)
    {
        for(int j=0;j<size-1;j++)
        {
            if(appliances[j].calculateUnits()<appliances[j+1].calculateUnits())
            {
                Appliance temp=appliances[j];
                appliances[j]=appliances[j+1];
                appliances[j+1]=temp;
            }
        }
    }
    cout<<"\nAppliance Consumption Ranking"<<endl;
    for(int i =0;i<size;i++)
    {
        cout<<"Rank"<<i+1<<":";
        appliances[i].display();
    }
}
void energySavingSuggestion(Appliance appliances[],int size)
{
    cout<<"\nEnergy Saving Suggestion\n";
    cout<<"Highest consumption appliance:"
    <<appliances[0].name<<endl;
    cout<<"Monthly Consumption: "
    <<appliances[0].calculateUnits()
    <<" units"<<endl;
    cout<<"Suggestion: Reduce usuage hours or use an energy efficient appliance."
        <<endl;
}
