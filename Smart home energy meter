class Tariff
{
public:

    virtual double calculate(double units)=0;

    virtual ~Tariff()
    {

    }

};
class DomesticTariff : public Tariff
{
public:
    double calculate(double units) override
    {
        double bill=0;

        if(units<=100)
            bill=units*2;
        else if(units<=200)
            bill=(100*2)+(units-100)*3;
        else if(units<=300)
            bill=(100*2)+(100*3)+(units-200)*5;
        else
            bill=(100*2)+(100*3)+(100*5)+(units-300)*7;
        return bill;
    }
};
class CommercialTariff : public Tariff
{
public:
    double calculate(double units)override
    {
    double bill=0;
    if (units<=100)
        bill=units*4;
    else if(units<=200)
        bill=(100*4)+(units-100)*5;
    else if(units<=300)
        bill=(100*4)+(100*5)+(units-200)*7;
    else
        bill=(100*4)+(100*5)+(100*7)+(units-300)*9;
    return bill;
    }
};
class AgricultureTariff : public Tariff
{
public:
    double calculate(double units)override
    {
        double bill =0;

        if (units<=100)
            bill=units*1;
        else if(units<=200)
            bill=(100*1)+(units-100)*1.5;
        else if(units<=300)
            bill=(100*1)+(100*1.5)+(units-200)*2;
        else
            bill=(100*1)+(100*1.5)+(100*2)+(units-300)*3;
        return bill;
    }

};
enum TariffType
{
    DOMESTIC,
    COMMERCIAL,
    AGRICULTURE,
    INVALID
};
class Consumer
{
public:
    string name;
    int ConsumerID;
    TariffType category;

    void setCategory()
    {
        int choice;

        cout<<"Select Consumer Category:\n";
        cout<<"1.Domestic\n";
        cout<<"2.Commercial\n";
        cout<<"3.Agriculture\n";

        cin>>choice;

        if(choice==1)
            category=DOMESTIC;
        else if(choice==2)
            category=COMMERCIAL;
        else if(choice==3)
            category=AGRICULTURE;
        else
            category=INVALID;
    }

    Tariff* selectTariff()
    {
        if(category==DOMESTIC)
            return new DomesticTariff();
        else if(category==COMMERCIAL)
            return new CommercialTariff();
        else if(category==AGRICULTURE)
            return new AgricultureTariff();
        else
            return nullptr;

    }

};
class Bill
{
public:
    double units;
    double amount;

    Bill()
    {
        units=0;
        amount=0;
    }

    Bill(const Bill &b)
    {
        units=b.units;
        amount=b.amount;
    }

    double addFixedCharge()
    {
        return 100;
    }
    double calculateDuty(double energyCharge)
    {
        return energyCharge*0.05;
    }
    double generateBill(double energyCharge)
    {
        double fixedCharge=addFixedCharge();
        double duty=calculateDuty(energyCharge);

        return energyCharge+fixedCharge+duty;
    }
    void applyDiscount(double &totalBill)
    {
        totalBill=totalBill-50;
    }
    operator double()
    {
        return amount;
    }
    void saveBill()
    {
        ofstream file("bills.dat",ios::binary|ios::app);
        if(!file)
        {
            cout<<"File not opening error"<<endl;
            return;
        }
        file.write(reinterpret_cast<const char*>(this),sizeof(*this));

        file.close();
        cout<<"Bill saved successfully"<<endl;
    }
    void readBill()
    {
        Bill b;
        ifstream file("bills.dat",ios::binary);

        if(!file)
        {
            cout<<"Unable to open bill history"<<endl;
            return;
        }

        while(file.read(reinterpret_cast<char*>(&b),sizeof(b)))
        {


            cout<<"Units: "<<b.units<<endl;
            cout<<"Amount: "<<b.amount<<endl;
        }
        file.close();

    }
    ~Bill()
    {
        cout<<"Bill object destroyed"<<endl;
    }

};
